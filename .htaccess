DirectoryIndex index.php
Options -Indexes

# 설정·스키마·문서 파일 직접 접근 차단
<FilesMatch "(\.(sql|md|sample\.php|log)|^\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# http → https 자동 이동 (2026-10-23 켬, 사이트가 https 로 열림)
#  앞단 프록시가 https 를 받아 http 로 넘기는 경우(X-Forwarded-Proto: https)에는 다시 보내지 않는다 (무한 이동 방지)
#  문제가 생기면 아래 <IfModule> 묶음(5줄) 앞에 # 를 붙여 끄면 된다
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
